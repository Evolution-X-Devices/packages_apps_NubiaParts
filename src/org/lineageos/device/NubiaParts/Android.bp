java_defaults {
    name: "NubiaParts_defaults",
    defaults: [
        "SettingsLibDefaults",
    ],
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.compose.material3_material3",
        "com.google.android.material_material",
        "NubiaPartsRes_shared",
    ],
    srcs : ["SharedConstants.java"],
    optimize: {
        enabled: false,
    },
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
        privileged: true,
        system_ext_specific: true,
        certificate: "platform",
        platform_apis: true,
}

android_app {
    name: "NubiaFanControl",
    srcs: [
        "Utils/*.java",
        "fancontrol/*.java",
    ],
    manifest: "fancontrol/AndroidManifest.xml",

    resource_dirs: [
        "fancontrol/res",
    ],

    defaults: [
        "NubiaParts_defaults",
    ],
    required: ["NubiaParts_main"],
}

android_app {
    name: "NubiaGameKeys",
    srcs: [
        "Utils/*.java",
        "gamekeys/**/*.java",
    ],
    manifest: "gamekeys/AndroidManifest.xml",

    resource_dirs: [
        "gamekeys/res",
    ],

    defaults: [
        "NubiaParts_defaults",
    ],
    required: ["NubiaParts_main"],
}

android_app {
    name: "NubiaGameSwitch",
    srcs: [
        "Utils/*.java",
        "gameswitch/*.java",
        "gameswitch/actions/*.java",
    ],
    manifest: "gameswitch/AndroidManifest.xml",

    resource_dirs: [
        "gameswitch/res",
    ],

    defaults: [
        "NubiaParts_defaults",
    ],
    required: [
        "NubiaPartsHelper",
        "privapp_whitelist_gameswitch",
        "NubiaParts_main",
    ],
}

android_app {
    name: "NubiaPartsHelper",
    srcs: [
        "helper/*.java",
    ],
    manifest: "helper/AndroidManifest.xml",
    defaults: [
        "NubiaParts_defaults",
    ],
}


android_app {
    name: "NubiaPowerUtils",
    srcs: [
        "Utils/*.java",
        "power/*.java",
    ],

    resource_dirs: [
        "power/res",
    ],

    manifest: "power/AndroidManifest.xml",
    defaults: [
        "NubiaParts_defaults",
    ],
    required: [
        "privapp_whitelist_nubia_power_utils",
        "NubiaParts_main",
    ],
}

android_app {
    name: "NubiaParts_main",
    defaults: ["NubiaParts_defaults"],
    srcs: [
        "NubiaPartsActivity.java",
        "NubiaPartsFragment.java",
    ],
    manifest: "AndroidManifest.xml",
}

android_library {
    name: "NubiaPartsRes_shared",
    resource_dirs: ["res"],
    manifest: "AndroidManifest_res.xml",
    srcs: [],
}

prebuilt_etc {
    name: "privapp_whitelist_gameswitch",
    src: "gameswitch/privapp_whitelist_gameswitch.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_nubia_power_utils",
    src: "power/privapp_whitelist_nubia_power_utils.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}

